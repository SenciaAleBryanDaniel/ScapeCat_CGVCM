# ==========================================
# Unity 6.x .gitignore
# Compatible con Unity 6.5
# ==========================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Crash reports
sysinfo.txt
mono_crash.*
*.stacktrace

# Visual Studio
.vs/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider
.idea/
*.DotSettings.user

# VS Code
.vscode/

# Consulo
.consulo/

# Gradle
.gradle/

# Exported projects
ExportedObj/

# Logs
*.log

# Unity generated meta
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Blender temp
*.blend1
*.blend1.meta

# Build outputs
*.apk
*.aab
*.app
*.exe
*.ipa
*.unitypackage
*.unitypackage.meta

# Addressables
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# Visual Scripting
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Test Runner
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/TestResults/

# Scene Dependency Cache
/[Aa]ssets/[Ss]ceneDependencyCache*

# Crashlytics
crashlytics-build.properties

# NuGet
.nuget/

# OS generated files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# Backup files
*.bak
*.orig
*.old
*.temp
*.tmp~

# Package archives
*.tgz

# Asset Store Tools (descomenta si los usas)
# /Assets/AssetStoreTools*

# JetBrains plugin
/Assets/Plugins/Editor/JetBrains*
